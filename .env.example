# EmpireOne Health lead form email settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@empireonehealth.com
SMTP_PASS=replace-with-email-password
# Alternate accepted name if your host uses this key:
# SMTP_PASSWORD=replace-with-email-password
MAIL_FROM_NAME=EmpireOne Health
LEAD_TO_EMAIL=info@empireonehealth.com

# Optional Ask Ava AI chatbot settings.
# Without this key, Ask Ava still answers from the local approved knowledge base.
GROQ_API_KEY=
AI_CHAT_MODEL=llama-3.3-70b-versatile

# Optional abuse protection settings.
CONTACT_RATE_LIMIT=8
SUBSCRIBE_RATE_LIMIT=10
AI_CHAT_RATE_LIMIT=20

# Set true in production only if you have an approved retention policy for chat logs.
AI_CHAT_LOGS_ENABLED=false
