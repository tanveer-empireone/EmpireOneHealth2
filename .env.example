# EmpireOne Health lead form email settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@empireonehealth.com
SMTP_PASS=replace-with-email-password
MAIL_FROM_NAME=EmpireOne Health
LEAD_TO_EMAIL=info@empireonehealth.com

# Optional Salesforce Web-to-Lead settings.
# Leave blank if Salesforce should not receive website leads yet.
SALESFORCE_WEB_TO_LEAD_OID=
SALESFORCE_RET_URL=https://empireonehealth.com/contact

# Optional Ask Ava AI chatbot settings.
# Without this key, Ask Ava still answers from the local approved knowledge base.
GROQ_API_KEY=
AI_CHAT_MODEL=llama-3.3-70b-versatile
